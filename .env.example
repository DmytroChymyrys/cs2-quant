DATABASE_URL=
CRON_SECRET=
SKINPORT_CURRENCY=USD
SKINPORT_REQUEST_TIMEOUT_MS=20000
SOURCE_STALE_AFTER_MINUTES=15
# Set to the first scheduled UTC five-minute boundary when enabling cron.
COLLECTION_SCHEDULE_STARTED_AT=
# Local scheduler administration only; never deploy this key.
CRON_JOB_ORG_API_KEY=

# Product feature branch; use an isolated database for development/migrations.
PRODUCT_DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
# Set only after the separate protected alert evaluator is scheduled and verified.
ALERT_SCHEDULE_ENABLED=

# Existing Skinport source stays enabled by default; does not change its schedule.
SKINPORT_DIRECT_ENABLED=true
# Experimental provider: never collected by the Skinport scheduler.
# Endpoint/venue mapping remains pending even if credentials are supplied.
CS2SH_ENABLED=false
CS2SH_API_KEY=
# Optional full-response retention contract; requires an isolated sink + expiry cleanup.
# Existing per-asset observation provenance is preserved independently.
RAW_SOURCE_RETENTION_ENABLED=false
RAW_SOURCE_RETENTION_DAYS=7

# Optional. Asset imagery is ENABLED by default, including when absent or empty.
# Set explicitly to false to disable all asset imagery and health probes.
ASSET_IMAGES_ENABLED=true

# Optional imagery metadata persistence (defaults to PRODUCT_DATABASE_URL / DATABASE_URL).
# Apply npm run db:migrate:imagery with an explicit target before rollout.
# ASSET_IMAGES_DATABASE_URL=postgresql://...
# Schedule POST /api/internal/asset-images/health every 10 minutes with CRON_SECRET.

# Explicit catalog subsystem connection; never falls back to the collector DB.
# Migrate with npm run db:migrate:catalog, then npm run catalog:sync.
# CATALOG_DATABASE_URL=postgresql://...

# Offline derived analytics. Source is READ ONLY; destination must be a separate DB.
# No fallback to DATABASE_URL, no automatic job or migration.
MARKET_ANALYTICS_SOURCE_URL=
DERIVED_MARKET_DATABASE_URL=

# Product reads only a reviewed derived snapshot. Fixture mode is rejected in production.
# database = reviewed snapshots; demo = realistic local preview; fixture = QA edge cases.
# Both synthetic modes are disabled when NODE_ENV=production.
PRODUCT_ANALYTICS_MODE=database
PRODUCT_ANALYTICS_SNAPSHOT_ID=
