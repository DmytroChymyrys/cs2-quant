{
  "name": "cs2-quant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "discover": "tsx scripts/discover.ts",
    "seed": "tsx scripts/seed.ts",
    "inspect:collection": "tsx scripts/inspect-collection.ts",
    "discovery:report": "node --import tsx scripts/discovery-report.ts",
    "inspect:smoke": "node --import tsx scripts/inspect-smoke.ts",
    "poc:report": "node --import tsx scripts/prepare-poc-universe.ts",
    "test:e2e": "playwright test",
    "format:product": "prettier --write src/components src/lib/product",
    "db:migrate:product": "node --import tsx scripts/migrate-product.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.3",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.3",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lossless-json": "^4.3.1",
    "lucide-react": "^1.43.0",
    "next": "^16.3.4",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.27.0",
    "stripe": "^22.6.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "type": "module",
  "overrides": {
    "better-auth": {
      "vitest": "$vitest"
    }
  }
}
