{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "functions": {
    "src/app/api/internal/refresh/route.ts": {
      "memory": 3009,
      "maxDuration": 300
    },
    "src/app/api/internal/collect/steamwebapi/route.ts": {
      "memory": 3009,
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/internal/refresh",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/internal/asset-images/health",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/internal/collect/steamwebapi",
      "schedule": "40 * * * *"
    }
  ]
}
