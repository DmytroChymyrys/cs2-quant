# Copy to .env.billing-sandbox.local; never commit the completed file.
# This is a separate billing staging environment, not the public read-only demo.
FLOATALPHA_BILLING_SANDBOX=true
PRODUCT_ANALYTICS_MODE=demo

# An isolated account-only database. Never use the collector connection here.
PRODUCT_DATABASE_URL=
BILLING_DATABASE_NAME=

# Actual deployed billing staging origin; use localhost only for local testing.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
# Alternatively configure the existing Google sign-in provider.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=

# Hosted Checkout/Portal do not require a publishable key in this application.
# Do not set FLOATALPHA_DEMO_PREVIEW, DATABASE_URL, provider/collector credentials,
# ASSET_IMAGES_DATABASE_URL or DERIVED_MARKET_DATABASE_URL in this environment.
